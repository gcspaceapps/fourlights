{
  "name": "fourlights",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "cf dev",
    "build": "tsc -p web --noEmit && cf build",
    "format": "prettier --write . && ruff format pipeline",
    "lint": "eslint .",
    "typecheck": "tsc -p api --noEmit && tsc -p web --noEmit",
    "check": "prettier --check . && eslint . && npm run typecheck && ruff check pipeline && ruff format --check pipeline",
    "check:real-data": "node scripts/check-real-data.mjs",
    "deploy": "npm run check && cf deploy",
    "preview": "npm run check && cf workers versions create --preview-alias",
    "fake-data": "node scripts/make-fake-data.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@eslint/js": "^10.0.1",
    "cf": "1.0.0-beta.32",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "workerd@1.20261113.1": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "hono": "^4.13.18"
  }
}
