{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Obscure name on purpose until the repo goes public (Sun 15 Nov 19:30 AEST).
  "name": "q7m3-demo",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "e3cb8bffb3a1a6e6009c50fdf0bc6b82",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    // Every request goes through the Worker so the weekend password covers pages and data too.
    "run_worker_first": true,
  },
  "observability": { "enabled": true },
  // Workers AI: only /api/ask uses it, to turn a typed question into planner settings.
  "ai": { "binding": "AI" },
  // The demo lives on our own domain. Every request, pages and data, goes through the Worker's
  // password gate while SITE_PASSWORD is set (see api/CONTEXT.md).
  "routes": [{ "pattern": "fourlights.gcsa.space", "custom_domain": true }],
  // One public URL: no <name>.workers.dev. Preview URLs stay on for `wrangler versions upload`
  // (Matt and second sessions); they run the same code, so they are password-gated too.
  "workers_dev": false,
  "preview_urls": true,
}
