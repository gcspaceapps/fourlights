{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Obscure name on purpose until the repo goes public (Sun 15 Nov 19:30 AEST).
  "name": "q7m3-demo",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "e3cb8bffb3a1a6e6009c50fdf0bc6b82",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    // Every request goes through the Worker so the weekend password covers pages and data too.
    "run_worker_first": true,
  },
  // One Durable Object per shared project: its state and its live WebSockets (api/src/project.ts).
  // SQLite-backed, so it runs on the Workers Free plan.
  "durable_objects": { "bindings": [{ "name": "PROJECTS", "class_name": "Project" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Project"] }],
  "observability": { "enabled": true },
  // The QGIS pack's three 20 m rasters (30 to 65 MB each; a static asset cannot be over 25 MiB),
  // served at /qgis/r2/<key> behind the same password gate. The bucket is private; its files are
  // uploaded by hand when they change (pipeline/CONTEXT.md).
  "r2_buckets": [{ "binding": "QGIS_BUCKET", "bucket_name": "q7m3-qgis-poc" }],
  // Workers AI: only /api/ask uses it, to turn a typed question into planner settings.
  "ai": { "binding": "AI" },
  // The demo lives on our own domain. Every request, pages and data, goes through the Worker's
  // password gate while SITE_PASSWORD is set (see api/CONTEXT.md).
  "routes": [{ "pattern": "fourlights.gcsa.space", "custom_domain": true }],
  // One public URL: no <name>.workers.dev. Preview URLs stay on for `wrangler versions upload`
  // (Matt and second sessions); they run the same code, so they are password-gated too.
  "workers_dev": false,
  "preview_urls": true,
}
